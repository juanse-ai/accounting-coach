# =============================================================================
# SERVER-ONLY  —  never prefixed with PUBLIC_
# =============================================================================
# Astro inlines any PUBLIC_-prefixed variable into the client bundle. Anything
# below is read only from Astro frontmatter or from src/pages/api/* handlers,
# so it stays on the server.
#
# Since the switch to `output: 'server'`, these are needed BOTH at build time
# (the prerendered blog/podcast pages query Supabase during `astro build`) and
# at runtime (any future server endpoint). In Vercel, set them for every
# environment — Production, Preview and Development.

# NOTE: despite the name, this slot holds a SECRET key (sb_secret_...), not the
# anon/publishable key. It bypasses Row Level Security — never expose it.
# /api/chat also uses it to verify the caller's JWT and to count turns.
SUPABASE_URL=https://pukzbajrdrntkyqbkqzz.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB1a3piYWpyZHJudGt5cWJrcXp6Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NzUyOTQ1MSwiZXhwIjoyMTAzMTA1NDUxfQ.EzSsa1wSPVGuEoVrSrt7NFKcWBL68YMVZnKr0u4Vj1E


PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB1a3piYWpyZHJudGt5cWJrcXp6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc1Mjk0NTEsImV4cCI6MjEwMzEwNTQ1MX0.4e4hW8vktBrnnOprl5sMgidgUR8Xm6SocjPELUh-xg4
